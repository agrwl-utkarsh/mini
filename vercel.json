{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "devCommand": "npm run dev"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "https://reposense-backend.onrender.com/api/v1/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://reposense-backend.onrender.com/api/$1"
    },
    {
      "source": "/health",
      "destination": "https://reposense-backend.onrender.com/health"
    },
    {
      "source": "/docs",
      "destination": "https://reposense-backend.onrender.com/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://reposense-backend.onrender.com/openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}