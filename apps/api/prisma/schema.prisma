generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FACULTY
  ORGANIZER
  VOLUNTEER
  PARTICIPANT
  SPONSOR
  FINANCE_TEAM
}

enum EventStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  WAITLISTED
  ATTENDED
  NO_SHOW
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  REIMBURSED
}

enum SponsorshipStatus {
  PROSPECT
  NEGOTIATING
  COMMITTED
  RECEIVED
  COMPLETED
}

enum FeedbackType {
  GENERAL
  SPEAKER
  VENUE
  CONTENT
  ORGANIZATION
}

enum CertificateStatus {
  PENDING
  GENERATED
  ISSUED
  VERIFIED
  REVOKED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  name          String
  avatarUrl     String?
  role          Role      @default(PARTICIPANT)
  department    String?
  studentId     String?   @unique
  employeeId    String?   @unique
  phone         String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organizedEvents     Event[]           @relation("EventOrganizer")
  approvedEvents      Event[]           @relation("EventApprover")
  registrations       Registration[]
  assignedTasks       Task[]            @relation("TaskAssignee")
  reportedTasks       Task[]            @relation("TaskReporter")
  createdExpenses     Expense[]         @relation("ExpenseCreator")
  approvedExpenses    Expense[]         @relation("ExpenseApprover")
  feedback            Feedback[]
  certificates        Certificate[]
  checkedInRegistrations Registration[] @relation("RegistrationChecker")

  @@index([email])
  @@index([role])
  @@index([department])
}

model Venue {
  id          String   @id @default(uuid())
  name        String
  description String?
  capacity    Int
  location    String?
  amenities   String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events Event[]

  @@index([isActive])
}

model Event {
  id                   String        @id @default(uuid())
  title                String
  description          String?
  shortDescription     String?       @db.Text
  coverImageUrl        String?
  status               EventStatus   @default(DRAFT)
  startDate            DateTime
  endDate              DateTime
  registrationStartDate DateTime?
  registrationEndDate   DateTime?
  maxAttendees         Int?
  venueId              String?
  organizerId          String
  approvedById         String?
  approvedAt           DateTime?
  rejectionReason      String?
  isPublic             Boolean       @default(true)
  requiresApproval     Boolean       @default(true)
  tags                 String[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  venue       Venue?        @relation(fields: [venueId], references: [id])
  organizer   User          @relation("EventOrganizer", fields: [organizerId], references: [id])
  approvedBy  User?         @relation("EventApprover", fields: [approvedById], references: [id])
  registrations Registration[]
  tasks       Task[]
  budgets     Budget[]
  sponsors    Sponsorship[]
  feedback    Feedback[]
  certificates Certificate[]

  @@index([status])
  @@index([organizerId])
  @@index([venueId])
  @@index([startDate])
  @@index([tags])
}

model Registration {
  id                String              @id @default(uuid())
  eventId           String
  userId            String
  status            RegistrationStatus  @default(PENDING)
  ticketCode        String?             @unique
  qrCodeUrl         String?
  checkedInAt       DateTime?
  checkedInBy       String?
  waitlistPosition  Int?
  specialRequests   String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkedInByUser User?  @relation("RegistrationChecker", fields: [checkedInBy], references: [id])

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([status])
  @@index([ticketCode])
}

model Task {
  id          String       @id @default(uuid())
  eventId     String
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String?
  reporterId  String
  dueDate     DateTime?
  completedAt DateTime?
  tags        String[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  event     Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignee  User?  @relation("TaskAssignee", fields: [assigneeId], references: [id])
  reporter  User   @relation("TaskReporter", fields: [reporterId], references: [id])

  @@index([eventId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
}

model Budget {
  id             String   @id @default(uuid())
  eventId        String
  name           String
  allocatedAmount Float   @default(0)
  spentAmount    Float    @default(0)
  currency       String   @default("INR")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@index([eventId])
}

model Expense {
  id            String         @id @default(uuid())
  budgetId      String
  title         String
  description   String?
  amount        Float
  currency      String         @default("INR")
  status        ExpenseStatus  @default(PENDING)
  category      String?
  vendor        String?
  invoiceUrl    String?
  approvedById  String?
  approvedAt    DateTime?
  paidAt        DateTime?
  createdById   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  budget      Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  approvedBy  User?    @relation("ExpenseApprover", fields: [approvedById], references: [id])
  createdBy   User     @relation("ExpenseCreator", fields: [createdById], references: [id])

  @@index([budgetId])
  @@index([status])
  @@index([createdById])
}

model Sponsor {
  id          String   @id @default(uuid())
  name        String
  logoUrl     String?
  website     String?
  contactName String?
  contactEmail String?  @unique
  contactPhone String?
  tier        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sponsorships Sponsorship[]

  @@index([isActive])
  @@index([tier])
}

model Sponsorship {
  id           String                @id @default(uuid())
  eventId      String
  sponsorId    String
  amount       Float
  currency     String                @default("INR")
  status       SponsorshipStatus     @default(PROSPECT)
  benefits     String[]
  contractUrl  String?
  committedAt  DateTime?
  receivedAt   DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  event    Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sponsor  Sponsor @relation(fields: [sponsorId], references: [id])

  @@unique([eventId, sponsorId])
  @@index([eventId])
  @@index([sponsorId])
  @@index([status])
}

model Feedback {
  id        String        @id @default(uuid())
  eventId   String
  userId    String
  type      FeedbackType  @default(GENERAL)
  rating    Int
  comment   String?
  isAnonymous Boolean     @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([type])
}

model CertificateTemplate {
  id              String   @id @default(uuid())
  eventId         String
  name            String
  description     String?
  templateHtml    String
  templateCss     String?
  qrCodePosition  Json?
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event       Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  certificates Certificate[]

  @@index([eventId])
}

model Certificate {
  id                String             @id @default(uuid())
  eventId           String
  userId            String
  templateId        String
  certificateNumber String             @unique
  pdfUrl            String?
  status            CertificateStatus  @default(PENDING)
  issuedAt          DateTime?
  verifiedAt        DateTime?
  revokedAt         DateTime?
  revokedReason     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  event     Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  template  CertificateTemplate @relation(fields: [templateId], references: [id])

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([status])
  @@index([certificateNumber])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}