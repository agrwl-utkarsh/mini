# Backend Environment Variables
# Copy to .env and fill in values

# Optional: Gemini API Key for AI features
GEMINI_API_KEY=

# Repository storage settings
# On Vercel: use /tmp (ephemeral, 512MB limit)
# On Render/Fly.io/Railway: use persistent path
REPO_BASE_PATH=/tmp/reposense
MAX_REPO_SIZE_MB=100
CLONE_TIMEOUT_SECONDS=30
CLEANUP_INTERVAL_MINUTES=60

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS - Frontend URL
# On Vercel: automatically injected via FRONTEND_URL binding from vercel.json
# On other platforms: set to your frontend URL (e.g., https://your-app.vercel.app)
FRONTEND_URL=http://localhost:5173