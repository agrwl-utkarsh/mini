{
  "name": "reposense",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev --workspace=frontend",
    "dev:api": "cd backend && uvicorn app.main:app --reload --port 8000",
    "build": "npm run build --workspace=frontend",
    "build:web": "npm run build --workspace=frontend",
    "build:api": "echo 'Backend uses Python, no build step needed'",
    "lint": "npm run lint --workspace=frontend",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css,py}\"",
    "typecheck": "npm run typecheck --workspace=frontend",
    "test": "npm run test --workspace=frontend",
    "db:generate": "cd backend && pip install -r requirements.txt",
    "db:push": "echo 'Backend uses SQLite/PostgreSQL directly'",
    "db:migrate": "echo 'Backend uses SQLAlchemy/Alembic if needed'",
    "db:seed": "echo 'Backend seeding not configured'",
    "db:studio": "echo 'Backend studio not configured'",
    "start": "concurrently \"npm run start:api\" \"npm run preview\"",
    "start:api": "cd backend && uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "preview": "npm run preview --workspace=frontend",
    "prepare": "husky install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "husky": "^9.0.11",
    "prettier": "^3.2.5",
    "turbo": "^1.13.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.5.0"
}