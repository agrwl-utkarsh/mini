# Frontend Environment Variables
# Copy to .env and fill in values

# Backend API URL (used for local development)
# On Vercel, this is automatically replaced by BACKEND_URL binding
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Vercel Service Binding (injected automatically in production)
# BACKEND_URL=https://your-project.vercel.app/backend
# Do NOT set this manually - Vercel injects it via the binding in vercel.json